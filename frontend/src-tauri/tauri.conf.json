{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reely",
  "version": "0.7.3",
  "identifier": "ai.getacro.reely",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Reely",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Instagram reel research for clinics",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../build/dist/reely-backend": "backend/reely-backend",
      "../../build/dist-view/reely-backend": "backend/reely-backend-view"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCN0YzNTJCQUI4NTE0NkEKUldScUZJV3JLelYvNnhHZEtZOHIrY0JxSFFhMklUNkI0cHJqOHZkUEMvT3JERDcrY3hOQkYzRGgK",
      "endpoints": [
        "https://github.com/Akki-16/reely/releases/latest/download/latest.json"
      ]
    }
  }
}